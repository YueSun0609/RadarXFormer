{
    "note": "V1 image-only ablation: monocular ResNet101/FPN and 2D deformable attention",

    "dataset": "kradar_image_only",

    "computing": {
        "dtype": "float32",
        "seed": 42,
        "workers": 4,
        "device": "cuda",
        "ddp_find_unused_parameters": false,
        "ddp_static_graph": true
    },

    "data": {
        "camera": "M",
        "normalize_camera": true,
        "camera_mean": [0.485, 0.456, 0.406],
        "camera_std": [0.229, 0.224, 0.225],
        "radar": "",
        "revision": "rev1",
        "validation_split": "test",
        "lidar2image_mono": [
            [629.80, -527.51, -4.6035, -382.80],
            [372.53, 9.4429, -560.47, -260.79],
            [0.99993, 0.012217, 0.00010661, -0.7],
            [0.0, 0.0, 0.0, 1.0]
        ],
        "image_size": "",
        "num_classes": 2,
        "categories": {
            "Sedan": 0,
            "Bus or Truck": -1,
            "Motorcycle": -1,
            "Bicycle": -1,
            "Bicycle Group": -1,
            "Pedestrian": -1,
            "Pedestrian Group": -1,
            "Background": -1
        },
        "fov": {
            "x": [0.0, 72.0],
            "y": [-6.4, 6.4],
            "z": [-2.0, 6.0],
            "azimuth": [-50, 50]
        }
    },

    "train": {
        "batch_size": 1,
        "shuffle": true,
        "epochs": 200,
        "logging": "epoch",
        "evaluating": 5,
        "compute_train_metrics": false,
        "checkpoint_interval": 5,
        "optimizer": {
            "name": "AdamW",
            "lr": 0.0001
        },
        "anassigner": "HungarianAnassigner",
        "criterion": "SetCriterion",
        "losses": {
            "class": "FocalLoss",
            "center": "L1Loss",
            "size": "L1Loss",
            "angle": "L1Loss"
        },
        "loss_inputs": {
            "class": ["class"],
            "center": ["center"],
            "size": ["size"],
            "angle": ["angle"]
        },
        "loss_weights": {
            "total_class": 1.0,
            "center": 1.0,
            "size": 1.0,
            "angle": 1.0
        },
        "scheduler": {
            "name": "ConstantLR",
            "factor": 1.0
        }
    },

    "model": {
        "name": "rxf",
        "inputs": [
            "camera_mono"
        ],
        "skiplinks": {
            "camera_mono": false
        },
        "backbones": {
            "camera_mono": {
                "name": "ResNet101",
                "weights": "IMAGENET1K_V2",
                "multi_scale": 4,
                "norm_layer": "FrozenBatchNorm2d"
            }
        },
        "necks": {
            "camera_mono": {
                "name": "FPN",
                "in_channels_list": [256, 512, 1024, 2048],
                "out_channels": 16
            }
        },
        "querent": {
            "name": "data_agnostic_static_querent",
            "transformation": "spher2cart",
            "resolution": [20, 20, 1],
            "minimum": [0, -50, 0],
            "maximum": [72, 50, 0]
        },
        "embeddings": {
            "camera_mono": {
                "name": "sinusoidal_embedding_2d",
                "num_feats": 16,
                "n_levels": 4,
                "normalize": true
            }
        },
        "fuser": {
            "name": "IMPFusionImageOnly",
            "i_iter": 4,
            "m_views": 1,
            "d_model": 16,
            "d_ffn": 32,
            "n_queries": 400,
            "n_levels": [4],
            "n_heads": [4],
            "n_points": [4],
            "norm": true,
            "dropout": 0.1,
            "modality_dropout": 0.0,
            "reduction": "mean",
            "activation": "Mish"
        },
        "head": {
            "name": "linear_detection_head",
            "in_channels": 16,
            "num_classes": 2,
            "num_reg_layers": 3,
            "num_cls_layers": 3
        }
    },

    "evaluate": {
        "name": "ImageOnlyEvaluator",
        "logging": "epoch",
        "compute_online_metrics": false,
        "run_inference_benchmark": false,
        "run_complexity_profile": false,
        "inference_repetitions": 100,
        "metrics": {
            "mAP": "mAP3D",
            "mGIoU": "mGIoU3D"
        },
        "exporter": {
            "name": "kradar",
            "conf_thrs": [0.0, 0.3, 0.5, 0.7, 0.9],
            "max_detections": 100,
            "single_pass_export": true
        }
    }
}
